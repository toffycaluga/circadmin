<p class="text-success"><%= notice %></p>

<%= render @invitation %>

<div class="mt-3">
  <%= link_to t("invitations.show.edit"), edit_invitation_path(@invitation), class: "btn btn-primary" %>
  <%= link_to t("invitations.show.back"), invitations_path, class: "btn btn-secondary" %>

  <%= button_to t("invitations.show.destroy"),
      @invitation,
      method: :delete,
      data: { turbo_confirm: t("invitations.show.confirm_destroy") },
      class: "btn btn-danger" %>
</div>
