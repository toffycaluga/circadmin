<div id="<%= dom_id invitation %>">
  <p>
    <strong>User:</strong>
    <%= invitation.user_id %>
  </p>

  <p>
    <strong>Circus:</strong>
    <%= invitation.circus_id %>
  </p>

  <p>
    <strong>Sender:</strong>
    <%= invitation.sender_id %>
  </p>

  <p>
    <strong>Message:</strong>
    <%= invitation.message %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= invitation.status %>
  </p>

</div>
