<p style="color: green"><%= notice %></p>

<%= render @transaction %>

<p>
  <strong><%= t("transactions.show.receipt") %>:</strong>
  <% if @transaction.receipt.attached? %>
    <%= link_to t("transactions.show.view_receipt"), url_for(@transaction.receipt), target: "_blank" %>
  <% else %>
    <%= t("transactions.show.no_receipt") %>
  <% end %>
</p>

<div>
  <%= link_to t("transactions.show.edit_link"), edit_transaction_path(@transaction) %> |
  <%= link_to t("transactions.show.back_link"), transactions_path %>

  <%= button_to t("transactions.show.destroy_link"), @transaction, method: :delete, data: { confirm: t("transactions.show.confirm_destroy") } %>
</div>
