<%= form_with(model: transaction, local: true, html: { multipart: true }) do |form| %>
  <% if transaction.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(transaction.errors.count, "error") %> impidieron guardar la transacción:</h2>
      <ul>
        <% transaction.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", style: "display: block" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div>
    <%= form.label :amount, "Monto", style: "display: block" %>
    <%= form.number_field :amount, step: 0.01, class: "form-control" %>
  </div>

  <%= form.hidden_field :transaction_type %>

  <div>
    <%= form.label :category, "Categoría", style: "display: block" %>
    <%= form.select :category,
      (transaction.transaction_type_income? ? Transaction::INCOME_CATEGORIES : Transaction::EXPENSE_CATEGORIES).map { |c| [c.titleize, c] },
      {},
      class: "form-control" %>
  </div>

  <div>
    <%= form.label :description, "Descripción", style: "display: block" %>
    <%= form.text_area :description, class: "form-control" %>
  </div>

  <div>
    <%= form.label :date, "Fecha y hora", style: "display: block" %>
    <%= form.datetime_local_field :date, class: "form-control" %>
  </div>

  <%# Campo para comprobante SOLO si es gasto %>
  <% if transaction.transaction_type_expense? || transaction.new_record? %>

    <div class="form-group">
      <%= form.label :receipt, "Comprobante (solo para gastos)" %>
      <%= form.file_field :receipt, class: "form-control" %>
    </div>
  <% end %>

  <%# No mostramos user_id ni circus_id porque se asignan automáticamente en el controller %>

  <div style="margin-top: 1rem">
    <%= form.submit "Guardar", class: "btn btn-primary" %>
  </div>
<% end %>
