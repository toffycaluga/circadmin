<p style="color: green"><%= notice %></p>

<% content_for :title, t("transactions.index.title") %>

<h1><%= t("transactions.index.heading") %></h1>

<div id="transactions">
  <% @transactions.each do |transaction| %>
    <%= render transaction %>
    <p>
      <%= link_to t("transactions.index.show_link"), transaction %>
    </p>
  <% end %>
</div>

<%= link_to t("transactions.index.new_link"), new_transaction_path %>
