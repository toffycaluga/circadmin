<div id="<%= dom_id transaction %>">
  <p>
    <strong><%= t("transactions.show.title") %>:</strong>
    <%= transaction.title %>
  </p>

  <p>
    <strong><%= t("transactions.show.amount") %>:</strong>
    <%= number_to_currency(transaction.amount, unit: currency_symbol(transaction.circus.currency)) %>
  </p>

  <p>
    <strong><%= t("transactions.show.transaction_type") %>:</strong>
    <%= t("transactions.type.#{transaction.transaction_type}") %>
  </p>

  <p>
    <strong><%= t("transactions.show.description") %>:</strong>
    <%= transaction.description.presence || t("transactions.show.no_description") %>
  </p>

  <p>
    <strong><%= t("transactions.show.date") %>:</strong>
    <%= l(transaction.date, format: :long) %>
  </p>

  <p>
    <strong><%= t("transactions.show.user") %>:</strong>
    <%= transaction.user&.user_profile&.full_name || t("transactions.show.unknown_user") %>
  </p>

  <p>
    <strong><%= t("transactions.show.circus") %>:</strong>
    <%= transaction.circus&.name || t("transactions.show.unknown_circus") %>
  </p>
</div>
