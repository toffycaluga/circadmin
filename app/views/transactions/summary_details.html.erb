<% content_for :page_title, t("transactions.details.title", default: "Detalle de transacciones") %>
<div class="card shadow-sm mb-4">
  <div class="card-header bg-light d-flex justify-content-between align-items-center">
    <h5 class="mb-0">
      <%= @type == "income" ? t("transactions.type.income", default: "Ingresos") : t("transactions.type.expense", default: "Egresos") %> —
      <%= formatted_label(@label, @group_type, @locality) %>
    </h5>
    <%= link_to t("transactions.details.back_to_summary", default: "Volver al resumen"),
            overview_transactions_locality_path(@locality, group: @group_type, type: @type, order: "date"),
            class: "btn btn-sm btn-outline-secondary" %>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th><%= t("transactions.fields.title", default: "Título") %></th>
            <th><%= t("transactions.fields.amount", default: "Monto") %></th>
            <th><%= t("transactions.fields.category", default: "Categoría") %></th>
            <th><%= t("actions.actions", default: "Acciones") %></th>
          </tr>
        </thead>
        <tbody>
          <% @transactions.each do |tx| %>
            <tr>
              <td><%= tx.title %></td>
              <td><%= number_to_currency(tx.amount, unit: currency_symbol(tx.locality.circus.currency)) %></td>
              <td><%= t("transactions.categories.#{tx.category}", default: tx.category.titleize) %></td>
              <td>
                <%= link_to t("actions.view_more", default: "Ver más"),
            card_transaction_path(tx),
            class: "btn btn-outline-info btn-sm" %>
              </tr>
            <% end %>
          </tbody>
        </table>1
      </div>
      <div class="text-end mt-4">
        <%= link_to t("transactions.details.back_to_summary", default: "Volver al resumen"),
            overview_transactions_locality_path(@locality, group: @group_type, type: @type, order: "date"),
            class: "btn btn-sm btn-outline-secondary" %>
      </div>
    </div>
  </div>
