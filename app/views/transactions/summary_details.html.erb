<% content_for :page_title, t("transactions.details.title", default: "Detalle de transacciones") %>
<div class="card shadow-sm mb-4">
  <div class="card-header bg-light d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
    <h5 class="mb-0">
      <%= @type == "income" ? t("transactions.type.income", default: "Ingresos") : t("transactions.type.expense", default: "Egresos") %>
      — <%= formatted_label(@label, @group_type, @locality) %>
    </h5>
    <div class="d-flex gap-2 flex-wrap justify-content-end mb-3">
      <%= link_to "📄 Exportar PDF", export_pdf_transactions_path(
        locality_id: @locality.id,
        type: @type,
        group: @group_type,
        label: @label
      ), class: "btn btn-warning btn-sm" %>
      <%= link_to "📊 Exportar Excel", export_excel_transactions_path(
        locality_id: @locality.id,
        type: @type,
        group: @group_type,
        label: @label,
        format: :xlsx
      ), class: "btn btn-info btn-sm" %>
      <%= link_to t("transactions.details.back_to_summary", default: "Volver al resumen"),
                overview_transactions_locality_path(@locality, group: @group_type, type: @type, order: "date"),
                class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>
  <div class="card-body">
    <% if @transactions.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th scope="col"><%= t("transactions.fields.date", default: "Fecha") %></th>
              <th scope="col"><%= t("transactions.fields.title", default: "Título") %></th>
              <th scope="col"><%= t("transactions.fields.amount", default: "Monto") %></th>
              <th scope="col"><%= t("transactions.fields.category", default: "Categoría") %></th>
              <th scope="col"><%= t("actions.actions", default: "Acciones") %></th>
            </tr>
          </thead>
          <tbody>
            <% @transactions.each do |tx| %>
              <tr>
                <td class="text-nowrap"><%= l(tx.created_at.to_date, format: :short) %></td>
                <td><%= tx.title %></td>
                <td><%= number_to_currency(tx.amount, unit: currency_symbol(tx.locality.circus.currency)) %></td>
                <td><%= t("transactions.categories.#{tx.category}", default: tx.category.titleize) %></td>
                <td>
                  <%= link_to t("actions.view_more", default: "Ver más"),
                      card_transaction_path(tx),
                      class: "btn btn-outline-info btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center text-muted my-4"><%= t("transactions.no_data", default: "No hay transacciones registradas.") %></p>
    <% end %>
    <div class="text-end mt-4">
      <%= link_to t("transactions.details.back_to_summary", default: "Volver al resumen"),
            overview_transactions_locality_path(@locality, group: @group_type, type: @type, order: "date"),
            class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>
</div>
