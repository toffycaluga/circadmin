wb = xlsx_package.workbook
wb.add_worksheet(name: t("transactions.export.title_excel")) do |sheet|
  styles = wb.styles

  # Estilos generales
  title_style  = styles.add_style sz: 14, b: true, alignment: { horizontal: :center }
  label_style  = styles.add_style b: true, sz: 10
  info_style   = styles.add_style sz: 10

  header_style = styles.add_style(
    b: true,
    sz: 11,
    alignment: { horizontal: :center },
    fg_color: "FFFFFF",
    bg_color: "336699",
    border: Axlsx::STYLE_THIN_BORDER,
    border_color: "000000"
  )

  cell_style = styles.add_style(
    sz: 9,
    alignment: { wrap_text: true, vertical: :top },
    border: Axlsx::STYLE_THIN_BORDER
  )

  # Estilo moneda nativo de Excel
  currency_style = styles.add_style(
    num_fmt: 5, # moneda estándar Excel (depende de la configuración regional del visor)
    alignment: { horizontal: :right },
    border: Axlsx::STYLE_THIN_BORDER
  )

  total_style  = styles.add_style b: true, sz: 10
  footer_style = styles.add_style sz: 9, i: true, alignment: { horizontal: :center }, fg_color: "777777"

  # Título principal
  sheet.add_row [ t("transactions.export.title_excel") ], style: title_style
  sheet.merge_cells("A1:F1")
  sheet.add_row []

  # Datos informativos
  sheet.add_row [ t("localities.labels.name"), @locality.title ],           style: [ label_style, info_style ]
  sheet.add_row [ t("circus.labels.name"),     @locality.circus.name ],     style: [ label_style, info_style ]
  sheet.add_row [ t("transactions.fields.type"), t("transactions.type.#{@type}") ], style: [ label_style, info_style ]

  if @transactions.any?
    min_date = I18n.l(@transactions.minimum(:date).to_date, format: :default)
    max_date = I18n.l(@transactions.maximum(:date).to_date, format: :default)
    sheet.add_row [ t("transactions.export.range"), "#{min_date} - #{max_date}" ], style: [ label_style, info_style ]
  end

  sheet.add_row [] # espacio antes de la tabla

  # Cabecera de la tabla
  sheet.add_row [
    t("transactions.fields.date"),
    t("transactions.fields.title"),
    t("transactions.fields.amount"),
    t("transactions.fields.category"),
    t("transactions.fields.description"),
    t("transactions.fields.user")
  ], style: header_style

  # Filas de transacciones
  @transactions.each do |tx|
    sheet.add_row [
      I18n.l(tx.date.to_date, format: :long),
      tx.title,
      tx.amount, # numérico puro, formato moneda via currency_style
      t("transactions.categories.#{tx.category}", default: tx.category.to_s.titleize),
      tx.description.to_s.truncate(100),
      (tx.user.user_profile&.full_name || tx.user.email)
    ], style: [ cell_style, cell_style, currency_style, cell_style, cell_style, cell_style ]
  end

  # Total final
  total = @transactions.sum(&:amount)
  sheet.add_row []
  sheet.add_row [ t("transactions.export.total"), "", total ],
                style: [ total_style, nil, currency_style ]

  # Footer generado por
  sheet.add_row []
  generated_at = I18n.l(Time.current, format: :default)
  sheet.add_row [ "#{t('transactions.export.generated_by')} — #{generated_at}" ], style: footer_style
  sheet.merge_cells("A#{sheet.rows.size}:F#{sheet.rows.size}")

  # Anchos personalizados
  sheet.column_widths 15, 20, 15, 20, 40, 30
end
