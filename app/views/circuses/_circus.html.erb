<div id="<%= dom_id circus %>">
  <p>
    <strong>Name:</strong>
    <%= circus.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= circus.description %>
  </p>

  <p>
    <strong>Country:</strong>
    <%= circus.country %>
  </p>

  <p>
    <strong>Currency:</strong>
    <%= circus.currency %>
  </p>

