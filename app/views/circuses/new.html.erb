<%# app/views/circuses/new.html.erb %>
<% content_for :title, t('circuses.new.title') %>

<div class="card shadow mb-4">
  <div class="card-header bg-primary text-white">
    <h1 class="h4 mb-0"><%= t('circuses.new.heading') %></h1>
  </div>
  <div class="card-body">
    <%= render 'form', circus: @circus %>
  </div>
  <div class="card-footer text-end">
    <%= link_to t('helpers.links.back'), circuses_path, class: 'btn btn-outline-secondary' %>
  </div>
</div>
