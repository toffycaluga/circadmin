<%= form_with(model: @circus, local: true, class: "needs-validation") do |form| %>
  <% if @circus.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@circus.errors.count, "error") %> impidieron guardar el circo:</h4>
      <ul>
        <% @circus.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control" %>
  </div>
  
  <div class="mb-3">
    <%= form.label :country, class: "form-label" %>
    <%= select_tag "circus[country]",
          options_for_select(country_options_with_flags, selected: @circus.country),
          class: "form-control", id: "country-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :currency, class: "form-label" %>
    <%= select_tag "circus[currency]",
          options_for_select(currency_options_data, selected: @circus.currency),
          id: "currency-select", class: "form-control" %>
  </div>

  <div class="form-check mb-3">
    <%#= form.check_box :active, class: "form-check-input" %>
    <%#= form.label :active, class: "form-check-label" %>
  </div>

  <div class="mb-3">
    <%= form.label :logo, "Logo del circo", class: "form-label" %>
    <%= form.file_field :logo, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.submit "Guardar", class: "btn btn-primary" %>
  </div>
<% end %>



<script>
  document.addEventListener("DOMContentLoaded", function () {
    const countrySelect = document.getElementById("country-select");
    const currencySelect = document.getElementById("currency-select");

    countrySelect.addEventListener("change", function () {
      const selectedOption = countrySelect.options[countrySelect.selectedIndex];
      const desiredCurrency = selectedOption.getAttribute("data-currency-code");

      if (!desiredCurrency) return;

      for (let i = 0; i < currencySelect.options.length; i++) {
        const option = currencySelect.options[i];
        if (option.value === desiredCurrency) {
          const newOption = option.cloneNode(true);
          newOption.selected = true;
          currencySelect.removeChild(option);
          currencySelect.insertBefore(newOption, currencySelect.firstChild);
          break;
        }
      }
    });
  });
</script>
