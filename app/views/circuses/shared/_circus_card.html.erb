<!-- app/views/circuses/shared/_circus_card.html.erb -->
<div class="card shadow-sm">
  <div class="card-header d-flex flex-wrap align-items-center gap-3">
    <!-- Logo del circo -->
    <%= image_tag(
      circus.logo.attached? ? url_for(circus.logo) : asset_path("default_circus_logo.jpg"),
      class: "rounded border",
      alt: t("dashboard.circus_logo_alt", default: "Logo del circo"),
      width: 80,
      height: 80,
      style: "object-fit: contain; aspect-ratio: 1/1; background: #fff;",
      loading: "lazy"
    ) %>

    <!-- Información del circo -->
    <div class="flex-grow-1">
      <h5 class="mb-1"><%= circus.name %></h5>
      <% user_role = current_user.circus_users.find_by(circus_id: circus.id)&.role %>
      <small class="<%= user_role ? 'text-muted' : 'text-danger' %>">
        <%= user_role ? t("roles.#{user_role}", default: user_role.capitalize) : t("dashboard.not_member", default: "No perteneces a este circo") %>
      </small>
      <div class="mt-1">
        <span class="badge <%= circus.active ? 'bg-success' : 'bg-secondary' %>">
          <%= circus.active ? t("circus.status.active", default: "Activo") : t("circus.status.inactive", default: "Inactivo") %>
        </span>
      </div>
    </div>

    <!-- Acciones principales -->
    <div class="ms-auto d-flex gap-2 flex-wrap justify-content-end">
      <%= link_to admin_circus_path(circus), class: "btn btn-sm btn-outline-primary d-flex align-items-center" do %>
        <i class="feather icon-sliders me-1"></i>
        <span><%= t("circus.actions.admin", default: "Administrar") %></span>
      <% end %>

      <%= link_to t("dashboard.actions.edit", default: "✏️ Editar"),
                  edit_circus_path(circus),
                  class: "btn btn-sm btn-outline-secondary d-flex align-items-center" %>
    </div>
  </div>

  <!-- Localidad activa -->
  <% if defined?(show_actions) && show_actions && (locality = circus.localities.active.last) %>
    <div class="card-footer bg-light">
      <div class="text-center text-muted small mb-2">
        <%= t("dashboard.active_locality", default: "Localidad activa:") %> <strong><%= locality.title %></strong>
      </div>

      <div class="d-flex flex-wrap gap-2 justify-content-center">
        <!-- Botón: Ingreso -->
        <%= link_to t("dashboard.actions.add_income", default: "💰 Ingreso"),
                    new_transaction_path(transaction_type: "income", locality_id: locality.id),
                    class: "btn btn-sm btn-outline-success",
                    data: {
                      controller: "subscription-check",
                      action: "click->subscription-check#check",
                      "subscription-check-required-service-value": "core",
                      "subscription-check-circus-id-value": circus.id
                    } %>

        <!-- Botón: Egreso -->
        <%= link_to t("dashboard.actions.add_expense", default: "💸 Egreso"),
                    new_transaction_path(transaction_type: "expense", locality_id: locality.id),
                    class: "btn btn-sm btn-outline-danger",
                    data: {
                      controller: "subscription-check",
                      action: "click->subscription-check#check",
                      "subscription-check-required-service-value": "core",
                      "subscription-check-circus-id-value": circus.id
                    } %>

        <%= link_to t("dashboard.actions.full_summary", default: "📊 Resumen de Ingresos y Gastos"),
                    overview_transactions_locality_path(locality),
                    class: "btn btn-sm btn-info" %>
      </div>
    </div>
  <% end %>
</div>
