<%= form_with model: [payroll, payroll_item],
              url: payroll_payroll_item_path(payroll, payroll_item),
              method: :patch,
              local: false,
              data: { turbo_frame: "payroll_item_modal" } do |f| %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :amount, class: "form-label" %>
    <%= f.number_field :amount, step: 0.01, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_area :notes, rows: 3, class: "form-control" %>
  </div>
  <div class="d-flex justify-content-end">
    <%= f.submit t("payroll_items.form.update", default: "Actualizar"), class: "btn btn-primary me-2" %>
  </div>
<% end %>
