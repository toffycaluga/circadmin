<%= turbo_stream.replace "payroll-items" do %>
  <%= render partial: "payroll_items/list",
             locals: { payroll: @payroll } %>
<% end %>

<%= turbo_stream.replace "modal" do %>
  <!-- simplemente lo vaciamos para que desaparezca -->
<% end %>

<%= turbo_stream.replace "payroll-total" do %>
  <%= number_to_currency(
        @payroll.total,
        unit: currency_symbol(@payroll.circus.currency),
        delimiter: ".",
        separator: ","
      ) %>
<% end %>
