<% content_for :page_title, t("notifications.title") %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0"><%= t("notifications.title") %></h1>

  <% if @notifications.any? { |n| !n.read } %>
    <%= button_to t("notifications.mark_all"),
                  mark_all_as_read_notifications_path,
                  method: :patch,
                  class: "btn btn-outline-secondary btn-sm",
                  form: { class: "d-inline" } %>
  <% end %>
</div>

<% if @notifications.empty? %>
  <div class="alert alert-info text-center">
    <%= t("notifications.none") %>
  </div>
<% else %>
  <ul class="list-group shadow-sm">
    <% @notifications.each do |notification| %>
      <li class="list-group-item d-flex justify-content-between align-items-start <%= 'bg-light' unless notification.read %>">
        <div class="me-3 flex-grow-1">
          <h6 class="mb-1"><%= notification.title %></h6>
          <p class="mb-1 text-muted"><%= notification.body %></p>
          <small class="text-muted">
            <i class="feather icon-clock me-1"></i>
            <%= t("notifications.time_ago", time: time_ago_in_words(notification.created_at)) %>
          </small>
        </div>

        <% unless notification.read %>
          <%= button_to t("notifications.mark_read"),
                        mark_as_read_notification_path(notification),
                        method: :patch,
                        class: "btn btn-sm btn-outline-primary align-self-start" %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="mt-3 justify-content-center d-flex">
    <%= raw pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>
