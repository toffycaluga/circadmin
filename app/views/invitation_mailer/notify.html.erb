<!-- app/views/invitation_mailer/notify.html.erb -->
<p>
  <%= t("mailers.invitation_mailer.notify.greeting",
         name: @invitation.user.user_profile&.full_name.presence || @invitation.user.email) %>
</p>

<p>
  <%= t("mailers.invitation_mailer.notify.body_html",
         circus_name: @invitation.circus.name,
         role: @circus_user&.role || t("mailers.invitation_mailer.notify.default_role")) %>
</p>

<p>
  <%= t("mailers.invitation_mailer.notify.instructions_html") %>
</p>
