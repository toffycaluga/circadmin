<!-- app/views/devise/mailer/email_changed.html.erb -->
<p><%= t("devise.mailer.email_changed.greeting", email: @email) %></p>

<% if @resource.try(:unconfirmed_email?) %>
  <p>
    <%= t("devise.mailer.email_changed.pending_change_html", new_email: @resource.unconfirmed_email) %>
  </p>
<% else %>
  <p>
    <%= t("devise.mailer.email_changed.changed_html", new_email: @resource.email) %>
  </p>
<% end %>
