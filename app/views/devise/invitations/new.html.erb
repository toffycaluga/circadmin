<%= form_for(User.new, as: :user, url: user_invitation_path, method: :post) do |f| %>
  <div class="form-group">
    <%= f.label :email, "Correo electrónico" %>
    <%= f.email_field :email, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :role, "Rol" %>
    <%= f.select :role, options_for_select([["Administrador", "admin"], ["Contador", "contador"], ["Representante", "representante"]]), {}, class: "form-control" %>
  </div>

  <%= f.submit "Enviar invitación", class: "btn btn-primary" %>
<% end %>
