<!-- app/views/home/_features.html.erb -->
<section class="features section">
  <div class="container">
    <div class="features-inner section-inner has-bottom-divider">
      <div class="features-wrap">
        <% features = [
          { emoji: "💰", key: "finance" },
          { emoji: "📊", key: "reports" },
          { emoji: "🔒", key: "roles" },
          { emoji: "📅", key: "events" },
          { emoji: "🧾", key: "exports" },
          { emoji: "🔔", key: "notifications" }
        ] %>

        <% features.each do |f| %>
          <div class="feature text-center">
            <div class="feature-inner">
              <div class="feature-icon" style="font-size:2rem;">
                <%= f[:emoji] %>
              </div>
              <h4 class="feature-title mt-24"><%= t("home.features.#{f[:key]}.title") %></h4>
              <p class="text-sm mb-0"><%= t("home.features.#{f[:key]}.description") %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
