

<%= render "home/hero",
    title:              t("hero.title", default: "Bienvenido a CircAdmin"),
    subtitle:           t("hero.subtitle", default: "Administra tu circo sin límites con nuestra plataforma todo en uno.")
%>

<%= render "home/features"%>


<% @plans.each do |plan| %>
  <%= render "home/pricing",
      title:          plan.name,
      subtitle:       plan_subtitle(plan),
      price:          (plan.price_cents / 100.0),
      frequency:      plan_frequency,
      features_title: t("home.pricing.features_title", default: "Qué incluye"),
      features:       plan_features(plan),
      cta_text:       plan_cta_text(plan),
      cta_url:        plan_cta_url(plan, circus: (defined?(@circus) ? @circus : nil)),
      plan:           plan %>
<% end %>


      <%= render "home/stats", stats: @stats %>

<%= render "home/cta",
    title:     t("cta.title", default: "¿Aún no estás convencido?"),
    cta_text:  t("cta.button", default: "Contáctanos"),
    cta_email: "info@cirxoft.com"
%>


<%# cta_path: new_subscription_path %>