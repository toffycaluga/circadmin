<div id="<%= dom_id user_profile %>">
  <p>
    <strong><%= t("user_profiles.show.user") %>:</strong>
    <%= user_profile.user_id %>
  </p>

  <p>
    <strong><%= t("user_profiles.show.full_name") %>:</strong>
    <%= user_profile.nombre_completo %>
  </p>

  <p>
    <strong><%= t("user_profiles.show.address") %>:</strong>
    <%= user_profile.direccion %>
  </p>

  <p>
    <strong><%= t("user_profiles.show.country") %>:</strong>
    <%= user_profile.pais %>
  </p>

  <p>
    <strong><%= t("user_profiles.show.currency_type") %>:</strong>
    <%= user_profile.tipo_moneda %>
  </p>
</div>
