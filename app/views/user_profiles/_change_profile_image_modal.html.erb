<!-- Modal cambio de imagen -->
<div class="modal fade" id="changeProfileImageModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-md">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= t("user_profiles.profile_picture.change_modal_title") %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('shared.actions.close') %>"></button>
      </div>
      <div class="modal-body">
        <%= render 'profile_picture_form', user_profile: current_user.user_profile %>
      </div>
    </div>
  </div>
</div>
