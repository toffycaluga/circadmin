<div class="card shadow-sm border-0">
  <div class="card-header bg-light">
    <h5 class="mb-0">
      <i class="feather icon-user me-2"></i>
      <%= t("profile.sections.personal_info", default: "Información personal") %>
    </h5>
    <small class="text-muted">
      <%= t("profile.sections.personal_info_subtext", default: "Datos que te identifican como usuario") %>
    </small>
  </div>

  <div class="card-body">
    <ul class="list-unstyled lh-lg mb-0">
      <li>
        <i class="feather icon-user text-muted me-2"></i>
        <strong><%= t("profile.labels.full_name") %>:</strong>
        <%= user.user_profile.full_name.presence || content_tag(:span, t("profile.labels.no_data"), class: "text-muted") %>
      </li>

      <li>
        <i class="feather icon-flag text-muted me-2"></i>
        <strong><%= t("profile.labels.country") %>:</strong>
        <%= user.user_profile.country.present? ?
              formatted_country_name(user.user_profile.country) :
              content_tag(:span, t("profile.labels.no_data"), class: "text-muted") %>
      </li>

      <li>
        <i class="feather icon-map-pin text-muted me-2"></i>
        <strong><%= t("profile.labels.address") %>:</strong>
        <%= user.user_profile.address.presence || content_tag(:span, t("profile.labels.no_data"), class: "text-muted") %>
      </li>
    </ul>
  </div>
</div>
