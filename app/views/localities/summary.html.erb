<% content_for :page_title, "Detalle del resumen" %>

<div class="col-12 col-lg-10 mx-auto">
  <div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-2">
        <i class="fas fa-chart-line text-primary fa-lg"></i>
        <h5 class="mb-0">
          <%= t("summary_card.#{params[:period]}") %> – <%= @locality.title %>
        </h5>
      </div>
      <div class="text-end">
        <span class="badge bg-light text-dark">
          <strong>Rango:</strong>
          <%= l(@summary[:range].first.to_date) %> – <%= l(@summary[:range].last.to_date) %>
        </span>
        <br>
        <span class="badge bg-success text-white mt-1">
          <strong>Total:</strong>
          <%= currency_symbol(@locality.circus.currency) %>
          <%= number_with_delimiter(@summary[:total], delimiter: ".", separator: ",") %>
        </span>
      </div>
    </div>

    <div class="card-body">
      <h6 class="text-muted mb-3">Transacciones registradas</h6>

      <% if @transactions.any? %>
        <table class="table table-striped table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Fecha</th>
              <th>Categoría</th>
              <th>Descripción</th>
              <th class="text-end">Monto</th>
            </tr>
          </thead>
          <tbody>
            <% @transactions.each do |tx| %>
              <tr>
                <td><%= l(tx.date.to_date) %></td>
                <td><%= t("transactions.categories.#{tx.category}", default: tx.category.titleize) %></td>
                <td><%= tx.title %></td>
                <td class="text-end">
                  <%= currency_symbol(@locality.circus.currency) %>
                  <%= number_with_delimiter(tx.amount, delimiter: ".", separator: ",") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="alert alert-warning mb-0">
          No hay transacciones registradas para este período.
        </div>
      <% end %>
    </div>

    <div class="card-footer bg-white text-end">
      <%= link_to "Volver", admin_locality_path(@locality), class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </div>
</div>
