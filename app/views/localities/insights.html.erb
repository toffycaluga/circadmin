<% content_for :page_title, t("insights.title", default: "Resumen e Insights") %>

<div class="col-12 col-lg-10 mx-auto mt-4 mb-5">
  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i><%= t("insights.title", default: "Resumen e Insights") %></h5>
    </div>

    <div class="card-body">
      <h6 class="text-muted mb-3">
        <%= t("insights.range", default: "Rango de fechas") %>:
        <strong><%= l(@start_date) %></strong> — <strong><%= l(@end_date) %></strong>
      </h6>

      <% if @summary_by_category.present? %>
        <h5 class="mb-3"><%= t("insights.summary.title", default: "Resumen por categoría") %></h5>
        <ul class="list-group list-group-flush mb-4">
          <% @summary_by_category.each do |category, amount| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%= t("transactions.categories.#{category}", default: category.titleize) %>
              <strong><%= currency_symbol(@locality.circus.currency) %> <%= number_with_delimiter(amount, delimiter: ".", separator: ",") %></strong>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="alert alert-info">
          <%= t("insights.summary.no_data", default: "No hay resumen disponible para este período.") %>
        </div>
      <% end %>

      <hr>

      <h5><%= t("insights.transactions.title", default: "Transacciones individuales") %></h5>

      <% if @transactions.present? %>
        <div class="table-responsive">
          <table class="table table-striped table-bordered">
            <thead>
              <tr>
                <th><%= t("transactions.date", default: "Fecha") %></th>
                <th><%= t("transactions.category", default: "Categoría") %></th>
                <th><%= t("transactions.title", default: "Descripción") %></th>
                <th><%= t("transactions.amount", default: "Monto") %></th>
              </tr>
            </thead>
            <tbody>
              <% @transactions.each do |tx| %>
                <tr>
                  <td><%= l(tx.date.to_date) %></td>
                  <td><%= t("transactions.categories.#{tx.category}", default: tx.category.titleize) %></td>
                  <td><%= tx.title %></td>
                  <td><%= currency_symbol(@locality.circus.currency) %> <%= number_with_delimiter(tx.amount, delimiter: ".", separator: ",") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-warning">
          <%= t("insights.transactions.no_data", default: "No hay transacciones para este período.") %>
        </div>
      <% end %>
    </div>
  </div>
</div>
