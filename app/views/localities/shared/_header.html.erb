<!-- app/views/localities/shared/_admin_card.html.erb -->
<div class="card p-3 mb-4">
  <h2 class="mb-3">
    🎪 <%= t("localities.admin.heading") %>:
    <%= locality.title.presence || t("localities.admin.untitled") %>
  </h2>

  <div class="row">
    <div class="col-md-8">
      <p class="mb-1">
        <strong><%= t("localities.fields.city") %>:</strong>
        <%= locality.city %>
      </p>
      <p class="mb-1">
        <strong><%= t("localities.fields.dates") %>:</strong>
        <%= l(locality.start_date) %>
        <% if locality.end_date.present? %>
          – <%= l(locality.end_date) %>
        <% else %>
          – <%= t("localities.admin.in_progress") %>
        <% end %>
      </p>
    </div>

    <div class="col-12 d-flex align-items-start justify-content-center mt-3 mt-md-0 row p-3">
      <% if can?(:manage, locality) %>
        <div class="mb-3 d-flex gap-2 justify-content-center col-md-4 col-sm-12">
          <%# Botón de egresos %>
          <%= link_to t("transactions.actions.add_expense"),
              new_transaction_path(transaction_type: "expense", locality_id: locality.id),
              class: "btn btn-danger",
              data: { action: "subscription-check#check" } %>

          <%# Botón de ingresos %>
          <%= link_to t("transactions.actions.add_income"),
              new_transaction_path(transaction_type: "income", locality_id: locality.id),
              class: "btn btn-success",
              data: {
                controller: "subscription-check",
                action: "click->subscription-check#check",
                "subscription-check-circus-id-value": locality.circus_id
              } %>
        </div>
      <% end %>

      <div class="col mb-3 d-flex gap-2 col-md-4 col-sm-12">
        <%= link_to t("dashboard.actions.full_summary", default: "📊 Resumen de Ingresos y Gastos"),
            overview_transactions_locality_path(locality),
            class: "btn btn-info w-100" %>
      </div>

      <% if can?(:manage, locality) %>
        <%= render "localities/shared/status_controls", locality: locality %>
      <% end %>
    </div>
  </div>
</div>
