<div class="card  <%= color_class %> mb-3">
  <div class="card-body ">
    <h6 class="text-white"><%= title %></h6>
    <h2 class="text-white"><%= currency_symbol(circus.currency) %> <%= number_with_precision(amount,
  precision: amount.to_f == amount.to_i ? 0 : 2,
  delimiter: ".", # separador de miles
  separator: ","  # separador decimal
) %>

  </div>
</div>
