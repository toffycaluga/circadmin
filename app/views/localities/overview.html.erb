<%= form_with url: overview_transactions_locality_path(@locality), method: :get, local: true do %>
  <div class="row mb-4">
    <div class="col-md-3">
      <%= select_tag :group,
          options_for_select([["Día", "daily"], ["Semana", "weekly"], ["Mes", "monthly"], ["Total", "total"]], @group_type),
          class: "form-control" %>
    </div>
    <div class="col-md-3">
      <%= select_tag :type,
          options_for_select([["Ingresos", "income"], ["Egresos", "expense"]], @type),
          class: "form-control" %>
    </div>
    <div class="col-md-3">
      <%= select_tag :order,
          options_for_select([["Fecha", "date"], ["Categoría", "category"]], @order),
          class: "form-control" %>
    </div>
    <div class="col-md-3">
      <%= submit_tag "Filtrar", class: "btn btn-primary w-100" %>
    </div>
  </div>
<% end %>
<div class="row">
  <% @summaries.each do |label, amount| %>
    <div class="col-md-4">
      <div class="card mb-3 shadow-sm">
        <div class="card-body">
          <h6 class="text-muted">
            <%= label.respond_to?(:strftime) ? l(label.to_date, format: :long) : label %>
          </h6>
          <h4><%= number_to_currency(amount, unit: currency_symbol(current_user)) %></h4>
         <%= link_to t("transactions.filters.see_more", default: "Ver más"),
            summary_details_transactions_locality_path(@locality,
                group: @group_type,
                type: @type,
                date: label.to_s),
            class: "btn btn-sm btn-outline-primary mt-2" %>


        </div>
      </div>
    </div>
  <% end %>
</div>
