<div class="card">
  <h1 class="mb-4">
    <%= t('payrolls.show.title', default: '🧾 Detalle de Nómina') %>
  </h1>
</div>
<div class="card mb-4">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Nombre</th>
          <th>Cargo</th>
          <th class="text-end">Monto</th>
          <th>Notas</th>
          <th></th>
        </tr>
      </thead>

      <!-- Aquí: el único tbody donde inyectaremos las filas -->
      <tbody id="payroll-items">
        <%= render partial: 'payrolls/rows',
                   locals: { payroll: @payroll, payroll_item: @payroll_item } %>
      </tbody>

      <tfoot>
        <tr>
          <td colspan="2"></td>
          <th class="text-end">Total nómina:</th>
          <td colspan="2" id="payroll-total">
            <%= render partial: 'payrolls/total', locals: { payroll: @payroll } %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<%= turbo_frame_tag "payroll_item_modal",
                    data: { 
                      controller: "modal",
                      action:"click->modal#close"
                    } do %>
  <!-- modal inyectado aquí -->
<% end %>
