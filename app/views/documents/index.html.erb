<% content_for :page_title, t("documents.index.title", default: "Mis Documentos por Circo") %>

<div class="row g-4">
  <% current_user.circuses.each do |circus| %>
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body d-flex flex-column justify-content-between">
          <div>
            <h5 class="card-title"><%= circus.name %></h5>
            <p class="text-muted small"><%= circus.country %></p>
          </div>
          <div class="mt-3 text-end">
            <%= link_to t("documents.index.view_docs_for", name: circus.name),
                        by_circus_documents_path(circus.id),
                        class: "btn btn-outline-primary btn-sm" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
