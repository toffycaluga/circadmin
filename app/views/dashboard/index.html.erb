<% content_for :page_title ,t("dashboard.title") %>
  
<% content_for :breadcrumb do %>
  <li class="breadcrumb-item"><%= link_to t("dashboard.title"), dashboard_index_path %></li>
  <%# <li class="breadcrumb-item active">Mis circos</li> %>
<% end %>



<div class=" col-sm-12">
    <div class="card table-card">
        <div class="card-header">


            <h1>Bienvenido a CircAdmin</h1>
            <%# <p>Este será tu panel principal.</p> %>
        </div>
    </div>
</div>
<h3>mis circos </h3>
<h3>Owned circuses</h3>
<% if @owned_circuses.any? %>
  <% @owned_circuses.each do |circus| %>
    <%= render partial: 'circuses/shared/circus_card', locals: { circus: circus } %>
  <% end %>
<% else %>
  <p>You don't own any circuses yet.</p>
<% end %>

<h3>Associated circuses</h3>
<% if @associated_circuses.any? %>
  <% @associated_circuses.each do |circus| %>
    <%= render partial: 'circuses/shared/circus_card', locals: { circus: circus } %>
  <% end %>
<% else %>
  <p>You are not associated with any circuses.</p>
<% end %>
