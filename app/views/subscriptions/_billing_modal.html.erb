<div class="modal fade" id="billingModal" tabindex="-1" aria-hidden="true" data-controller="billing">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" data-billing-target="title"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" data-billing-target="body"></div>
      <div class="modal-footer">
        <a href="#" data-billing-target="actionButton" class="btn btn-primary">Suscribirme</a>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
      </div>
    </div>
  </div>
</div>
