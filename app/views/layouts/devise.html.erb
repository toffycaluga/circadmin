<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-100">
  <head>
    <meta charset="utf-8">
    <title><%= t('layouts.application.title', default: 'CircAdmin') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
      <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- Bootstrap CSS -->
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css",
                            rel: "stylesheet", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <style>
      .main-devise {
        min-height: 100vh;
        display: flex;
        align-items: center;
        background-image: url('<%= asset_path("patron.png") %>');
        background-size: 150px;
        background-position: top left;
        background-repeat: repeat;
        position: relative;
      }
      .overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(255, 255, 255, 0.7);
        z-index: 0;
      }
      .content-card {
        position: relative;
        z-index: 1;
      }
    </style>
  </head>
  <body class="bg-light h-100 d-flex flex-column">
    <main class="main-devise flex-grow-1">
      <div class="overlay"></div>
      <div class="container content-card">
        <div class="row justify-content-center">
          <div class="col-12 col-sm-10 col-md-6">
            <!-- Volver al home -->
            <!-- Language selector -->
            <div class="mb-3 text-end">
              <%= render 'shared/language_selector' %>
            </div>
            <!-- Flash alerts -->
            <!-- Contenido principal dentro de una card para UX -->
            <div class="card shadow-sm">
              <div class="card-body p-4">
                <div class="mb-4">
                <%= render 'shared/alert' %>
                  <%= link_to home_index_path,
                          class: "btn btn-outline-primary",
                          aria: { label: t('layouts.application.back_home', default: 'Volver al inicio') } do %>
                    <i class="bi bi-house-door-fill me-1"></i>
                    <%= t('layouts.application.back_home', default: 'Volver al inicio') %>
                  <% end %>
                </div>
                <%= yield %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <!-- Footer -->
    <%= render 'shared/footer' %>
    <!-- Scripts al final del body -->
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js",
                               crossorigin: "anonymous" %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
            crossorigin="anonymous"></script>
  </body>
</html>
