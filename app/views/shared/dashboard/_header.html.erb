<header class="navbar navbar-expand-lg navbar-light header-blue p-2 pcoded-header">
  <div class="container-fluid d-flex align-items-center">
    <!-- 1) Hamburguesa + brand -->
    <button class="navbar-toggler me-2" type="button"
            data-bs-toggle="collapse" data-bs-target="#mainNavbar"
            aria-controls="mainNavbar" aria-expanded="false"
            aria-label="<%= t('navbar.toggle_menu', default: 'Abrir menú principal') %>">
      <span class="navbar-toggler-icon"></span>
    </button>

    <a href="#!" class="navbar-brand d-flex align-items-center">
      <%= image_tag 'icono_w.png', class: "logo me-2", loading: "lazy" %>
      <h3 class="mb-0"><%= t('navbar.brand', default: 'CircAdmin') %></h3>
    </a>

    <!-- 2) Tres puntos (utilidades) -->
    <div class="d-lg-none ms-auto">
      <div class="dropdown">
        <a href="#" class="nav-link p-1" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="feather icon-more-vertical fa-lg"></i>
        </a>
        <ul class="dropdown-menu dropdown-menu-end py-1">
          <li class="px-3">
            <%= render 'shared/dashboard/template_nav_menu/notificacion' %>
          </li>
          <li class="px-3">
            <%= render 'shared/language_selector' %>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li class="px-3">
            <%= link_to t('navbar.logout', default: 'Salir'),
                        destroy_user_session_path,
                        method: :delete,
                        class: 'dropdown-item' %>
          </li>
        </ul>
      </div>
    </div>

    <!-- 3) Collapses (ambos) -->
    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <!-- aquí tu buscador o enlaces -->
      </ul>
      <!-- en desktop, muestro notificaciones e idioma inline -->
      <ul class="navbar-nav mb-2 mb-lg-0 d-none d-lg-flex">
        <li class="nav-item">
          <%= render 'shared/dashboard/template_nav_menu/notificacion' %>
        </li>
        <li class="nav-item">
          <%= render 'shared/language_selector' %>
        </li>
        <li class="nav-item">
          <%= link_to t('navbar.logout', default: 'Salir'),
                      destroy_user_session_path,
                      method: :delete,
                      class: 'nav-link' %>
        </li>
      </ul>
    </div>
  </div>
</header>
