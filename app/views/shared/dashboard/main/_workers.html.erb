<% current_cu = current_user.circus_users.find_by(circus: @circus) %>
<% es_owner = current_cu&.role == "owner" %>
<% filtered_circus_users = if es_owner
  @circus_users.select do |cu|
    invitation = cu.user.invitations
                   .where(circus: @circus)
                   .order(created_at: :desc)
                   .first
    invitation && invitation.status != Invitation::STATUSES["rejected"]
  end
else
  @circus_users
end %>
<div class="col-lg-7 mb-4">
  <div class="card card table-card">
    <div class="card-body">
      <ul class="nav nav-tabs px-3 pt-3 mb-0" id="myTab" role="tablist">
        <li class="nav-item">
          <a class="nav-link active text-uppercase" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true">
            <%= t("workers.title") %>
          </a>
        </li>
        <% if es_owner %>
          <li class="nav-item">
            <a class="nav-link text-uppercase" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false">
              <%= t("workers.add") %>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-uppercase" id="contact-tab" data-toggle="tab" href="#contact" role="tab" aria-controls="contact" aria-selected="false">
              <i class="fas fa-cog"></i> <%= t("workers.edit") %>
            </a>
          </li>
        <% end %>
      </ul>
      <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
          <div class="table-responsive">
            <table class="table table-hover m-0">
              <thead>
                <tr>
                  <th><%= t("workers.user") %></th>
                  <th><%= t("workers.mail") %></th>
                  <th><%= t("workers.role") %></th>
                  <% if es_owner %>
                    <th><%= t("workers.status") %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% filtered_circus_users.each do |cu| %>
                  <tr>
                    <td>
                      <div class="text-center">
                        <%= image_tag(
                        cu.user.user_profile&.profile_picture&.attached? ?
                          url_for(cu.user.user_profile.profile_picture) :
                          asset_path("avatar.jpg"),
                        class: "img-radius img-fluid rounded-circle",
                        alt: "Foto de perfil",
                        width: 60,
                        height: 60,
                        style: "object-fit: cover; aspect-ratio: 1/1;",
          loading: "lazy"
                      ) %>
                        <h5 class="mt-2">
                          <%= cu.user.user_profile&.full_name.presence || content_tag(:span, "Nombre no disponible", class: "text-muted") %>
                        </h5>
                      </div>
                    </td>
                    <td>
                      <h6 class="mb-1"><%= cu.user.email %></h6>
                    </td>
                    <td><span class="fw-bold"><%= t("roles.#{cu.role}") %></span></td>
                    <% if es_owner %>
                      <td>
                        <% invitation = cu.user.invitations
                          .where(circus: @circus)
                          .where.not(status: Invitation::STATUSES["rejected"])
                          .order(created_at: :desc)
                          .first %>
                        <% puede_reenviar = invitation&.sender_id == current_user.id %>
                        <% if invitation.present? %>
                          <% if invitation.status == Invitation::STATUSES["pending"] %>
                            <div class="d-flex gap-3">
                              <span class="badge bg-warning text-dark">Pendiente</span>
                              <% if puede_reenviar %>
                                <%= button_to resend_email_custom_invitation_path(invitation),
                                  method: :post,
                                  class: "btn btn-sm btn-outline-secondary d-flex align-items-center gap-1",
                                  data: {
                                    turbo_confirm: "¿Estás seguro que deseas reenviar esta invitación? Se enviará nuevamente al correo del usuario."
                                  } do %>
                                  <i class="fas fa-paper-plane"></i> Reenviar
                                <% end %>
                              <% end %>
                            </div>
                          <% elsif invitation.status == Invitation::STATUSES["accepted"] %>
                            <span class="badge bg-success">Aceptado</span>
                          <% end %>
                        <% else %>
                          <span class="badge bg-secondary">Sin invitación</span>
                        <% end %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <% if es_owner %>
          <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th><%= t("users.invite.mail")%></th>
                    <th><%= t("users.invite.role_label")%></th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <%= render "shared/dashboard/main/invite_user_form" %>
                </tbody>
              </table>
            </div>
          </div>
          <div class="tab-pane fade" id="contact" role="tabpanel" aria-labelledby="contact-tab">
            <div class="table-responsive">
              <table class="table table-hover table-borderless">
                <thead>
                  <tr>
                    <th><%= t("users.invite.mail")%></th>
                    <th><%= t("users.invite.role_label")%></th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="circus-user-forms">
                  <% @circus_users.each do |cu| %>
                    <%= render partial: "shared/dashboard/main/circus_user_row", locals: { cu: cu } %>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>