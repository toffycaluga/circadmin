<div class="page-header">
  <div class="page-block">
    <div class="row align-items-center">
      <div class="col-md-12">
        <div class="page-header-title">
          <h5>
            <%= content_for?(:page_title) ? yield(:page_title) : t("dashboard.header.title", default: "Dashboard") %>
          </h5>
        </div>
        <ul class="breadcrumb">
          <li class="breadcrumb-item">
            <%= link_to root_path do %>
              <i class="feather icon-home"></i>
            <% end %>
          </li>
          <% if content_for?(:breadcrumb) %>
            <%= yield :breadcrumb %>
          <% else %>
            <li class="breadcrumb-item"><%= t("dashboard.header.breadcrumb", default: "Dashboard") %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
