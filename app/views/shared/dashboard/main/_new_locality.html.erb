<div class="col-md-6 col-lg-5 mb-4">
  <div class="card h-30">
    <div class="card-header d-flex align-items-center gap-2">
      <i class="fas fa-map-marker-alt text-primary"></i>
      <h5 class="mb-0"><%= t("dashboard.localities.title") %></h5>
    </div>

    <div class="card-body">
      <p class="mb-3 text-muted"><%= t("dashboard.localities.description") %></p>

      <%= link_to t("dashboard.localities.new_locality"),
          new_locality_path(circus_id: @circus.id),
          class: "btn btn-outline-primary w-100 mb-3" %>

      <% if @circus.localities.any? %>
        <ul class="list-group">
          <% @circus.localities.order(start_date: :desc).each do |locality| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <strong><%= locality.title %></strong><br>

                <small class="text-muted"><%= locality.city %> — <%= l(locality.start_date, format: :default) %></small>
             
              </div>
              <%= link_to t("dashboard.localities.admin"), admin_locality_path(locality), class: "btn btn-sm btn-outline-secondary w-50" %>
              <%# <%= link_to "Abrir evento", locality_path(locality), class: "btn btn-primary btn-sm" %> 
            </li>
          <% end %>
        </ul>
      <% else %>

        <p class="text-muted"><%= t("dashboard.localities.none_found", default: "Aún no hay localidades registradas.") %></p>
      <% end %>
    </div>
  </div>
</div>
