<div class="col-md-6 col-lg-5 mb-4 p-5">
  <div class="card table-card h-100 p-1">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="fas fa-coins"></i> <%= t("dashboard.financial_resources.title") %>
      </h5>
    </div>
    <div class="card-body">
      <p><%= t("dashboard.financial_resources.description") %></p>
      <div class="d-flex gap-2 flex-wrap">
        <div class="col p-0">
          <%= link_to t("transactions.actions.new_income"), new_income_transactions_path, class: "btn btn-success w-100" %>
        </div>
        <div class="col p-0">
          <%= link_to t("transactions.actions.new_expense"), new_expense_transactions_path, class: "btn btn-danger w-100" %>
        </div>
      </div>
    </div>
  </div>
</div>
