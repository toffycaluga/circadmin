<tr>
  <%= form_for(User.new, as: :user, url: user_invitation_path, method: :post, html: { class: "d-flex align-items-center gap-2" }) do |f| %>
    <td colspan="4">
      <div class="d-flex align-items-center">
        <%= f.email_field :email, class: "form-control form-control-sm", placeholder: t("users.invite.email_placeholder"), required: true, style: "min-width: 220px;" %>
      </div>
    </td>
    <td>
      <div class="d-flex align-items-center">
        <%= select_tag 'user[role]',
              options_for_select(
                  CircusUser::ROLES
                  .reject { |r| r == "owner" }
                  .map { |r| [role_label(r), r] }
              ),
              class: "form-control form-control-sm", required: true, style: "min-width: 150px;" %>
      </div>
    </td>
    <td>
      <div>
        <%= f.submit t("users.invite.submit"), class: "btn btn-sm btn-outline-success" %>
      </div>
    </td>
  <% end %>
</tr>
