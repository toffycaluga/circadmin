<header class="navbar pcoded-header navbar-expand-lg navbar-light header-blue">
  <div class="container-fluid p-0 position-relative">

    <!-- ===== MOBILE HEADER ===== -->
    <div class="d-flex d-lg-none align-items-center justify-content-between w-100 px-3">
      <!-- Botón hamburguesa -->
      <a class="mobile-menu text-white"
         href="#"
         data-action="click->navigation#toggle">
        <span></span>
      </a>

      <!-- Brand -->
      <%= link_to root_path, class: 'b-brand d-flex align-items-center' do %>
        <%= image_tag 'icono_w.png',
                      class: 'logo me-2',
                      loading: 'lazy',
                      alt: t('header.logo_alt', default: 'CircAdmin Logo') %>
        <span class="logo-text text-white h5 mb-0">CircAdmin</span>
      <% end %>

      <!-- Notificaciones + selector idioma móvil -->
      <div class="d-flex align-items-center gap-3">
        
        <%= render 'shared/dashboard/template_nav_menu/notificacion' %>
        <div class="dropdown">
          <a class="nav-link dropdown-toggle p-0 text-white"
             href="#"
             id="mobileLangDropdown"
             data-bs-toggle="dropdown"
             aria-expanded="false">
            <i class="feather icon-more-vertical"></i>
          </a>
          <ul class="dropdown-menu dropdown-menu-end"
              aria-labelledby="mobileLangDropdown">
            <%= render 'shared/language_selector' %>
          </ul>
        </div>
      </div>
    </div>

    <!-- ===== DESKTOP HEADER ===== -->
    <div class="d-none d-lg-flex align-items-center justify-content-between w-100 px-3">
      <!-- Brand -->
      <%= link_to root_path, class: 'b-brand d-flex align-items-center' do %>
        <%= image_tag 'icono_w.png',
                      class: 'logo me-2',
                      loading: 'lazy',
                      alt: t('header.logo_alt', default: 'CircAdmin Logo') %>
        <span class="logo-text text-white h5 mb-0">CircAdmin</span>
      <% end %>

      <!-- Menú derecho -->
      <ul class="navbar-nav align-items-center gap-3 mb-0">
        <li class="nav-item">
          <%= render 'shared/language_selector' %>
        </li>
        <li class="nav-item">
          <%= render 'shared/dashboard/template_nav_menu/notificacion' %>
        </li>
        <li class="nav-item dropdown drp-user">
          <!-- Dropdown usuario -->
          <a class="nav-link dropdown-toggle text-white"
             href="#"
             id="userDropdown"
             role="button"
             data-bs-toggle="dropdown"
             aria-expanded="false">
            <i class="feather icon-user"></i>
          </a>
          <div class="dropdown-menu dropdown-menu-end profile-notification"
               aria-labelledby="userDropdown">
            <div class="pro-head d-flex align-items-center px-3 py-2">
              <%= image_tag(
                    current_user&.user_profile&.profile_picture&.attached? ?
                      url_for(current_user.user_profile.profile_picture) :
                      asset_path("avatar.jpg"),
                    class: "img-radius rounded-circle border border-secondary",
                    alt: t("profile.picture_alt", default: "Foto de perfil"),
                    width: 40,
                    height: 40,
                    loading: "lazy",
                    style: "object-fit: cover;"
                  ) %>
              <div class="d-flex flex-column ms-2">
                <strong><%= current_user.user_profile&.full_name.presence || current_user.email %></strong>
                <small class="text-muted"><%= current_user.email %></small>
              </div>
              <%= button_to destroy_user_session_path,
                            method: :delete,
                            class: "ms-auto dud-logout btn",
                            form: { data: { turbo: false }, class: "d-inline ms-auto dud-logout" },
                            title: t("header.logout", default: "Cerrar sesión") do %>
                <i class="feather icon-log-out"></i>
              <% end %>
            </div>
            <ul class="pro-body list-unstyled mb-0">
              <li>
                <%= link_to user_profile_path(current_user),
                            class: "dropdown-item d-flex align-items-center" do %>
                  <i class="feather icon-user me-2"></i>
                  <%= t("header.profile", default: "Perfil") %>
                <% end %>
              </li>
            </ul>
          </div>
        </li>
      </ul>
    </div>

  </div>
</header>

<style>
  .logo {
    width: 32px;
    height: auto;
  }
  .pcoded-header .mobile-menu {
    float: left !important;
    position: relative !important;
    margin-right: 1rem;
  }
  @media (max-width: 991.98px) {
    .d-flex.d-lg-none {
      justify-content: space-between !important;
    }
    .b-brand {
      z-index: 1;
    }
    .mobile-menu,
    .dropdown {
      z-index: 2;
    }
  }
</style>
