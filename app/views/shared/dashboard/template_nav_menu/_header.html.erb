<div class="text-center p-3">
  <!-- Avatar -->
  <div class="main-menu-header mb-2">
    <%= image_tag(
          current_user&.user_profile&.profile_picture&.attached? ?
            url_for(current_user.user_profile.profile_picture) :
            asset_path("avatar.jpg"),
          class: "img-radius img-fluid rounded-circle border border-secondary",
          alt: t("profile.picture_alt", default: "Foto de perfil"),
          width: 100,
          height: 100,
          loading: "lazy",
          style: "object-fit: cover; aspect-ratio: 1/1;"
        ) %>
  </div>

  <!-- Nombre o email del usuario -->
  <% if current_user %>
    <div class="user-details mb-2">
      <strong class="d-block text-dark">
        <%= current_user.user_profile&.full_name.presence || current_user.email %>
      </strong>
      <small class="text-muted">
        <%= t("home.greeting_label", default: "¡Hola!") %>
      </small>
    </div>
  <% end %>

  <!-- Acciones del usuario -->
  <div class="d-flex justify-content-center gap-3 mt-3">
    <!-- Perfil -->
    <% if current_user %>
      <% if current_user.user_profile.present? %>
        <%= link_to profile_path,
                    class: "btn btn-outline-primary btn-sm",
                    title: t("user_profiles.show.title"),
                    aria: { label: t("user_profiles.show.title") } do %>
          <i class="feather icon-user"></i>
        <% end %>
      <% else %>
        <%= link_to new_user_profile_path,
                    class: "btn btn-outline-primary btn-sm",
                    title: t("user_profiles.new.title", default: "Crear perfil"),
                    aria: { label: t("user_profiles.new.title", default: "Crear perfil") } do %>
          <i class="feather icon-user-plus"></i>
        <% end %>
      <% end %>
    <% end %>

    <!-- Mensajes -->
    <%#= link_to "#",
                class: "btn btn-outline-secondary btn-sm position-relative",
                title: t("notifications.title", default: "Mensajes"),
                aria: { label: t("notifications.title", default: "Mensajes") } do %>
      <%# <i class="feather icon-mail"></i> %>
      <%# <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary"> %>
        <%# 5 %>
        <%# <span class="visually-hidden">= t("notifications.unread", default: "mensajes no leídos")</span> %>
      <%# </span> %>
    <%# end %>

    <!-- Logout -->
    <%= button_to destroy_user_session_path,
                  method: :delete,
                  class: "btn btn-outline-danger btn-sm",
                  form: { data: { turbo: false }, class: "d-inline" },
                  title: t("devise.logout"),
                  aria: { label: t("devise.logout") } do %>
      <i class="feather icon-power"></i>
    <% end %>
  </div>
</div>
